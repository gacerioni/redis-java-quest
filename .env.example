# Redis Java Quest: configuracao local
# Copie para .env e ajuste. O .env nunca vai pro git.

# URL do seu Redis. Exemplos:
#   Redis Cloud free:  redis://default:SUA_SENHA@redis-12345.c308.sa-east-1-1.ec2.redns.redis-cloud.com:12345
#   Docker local:      redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Prefixo de todas as chaves criadas pelas licoes (opcional).
# Padrao: o usuario da URL quando nao for "default", senao "quest".
# QUEST_PREFIX=seu-nome

# Licao 301-03 (TLS): URL rediss:// de um banco pago. O plano free nao tem TLS.
# REDIS_TLS_URL=rediss://default:SENHA@host:porta

# Licao 201-03 (busca hibrida): Ollama local para gerar o vetor de perguntas novas.
# Sem isso, a licao usa perguntas pre-computadas que ja vem no repo.
# OLLAMA_URL=http://localhost:11434
