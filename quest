#!/usr/bin/env bash
# Redis Java Quest CLI wrapper.
#   ./quest list
#   ./quest seed
#   ./quest run 101-02 jedis
#   ./quest run 101-02 lettuce
#   ./quest check 101-02
set -euo pipefail
cd "$(dirname "$0")"

if [ -f .env ]; then
  set -a
  # shellcheck disable=SC1091
  . ./.env
  set +a
fi

JAR="target/quest.jar"
needs_build() {
  [ ! -f "$JAR" ] && return 0
  [ "${QUEST_REBUILD:-0}" = "1" ] && return 0
  [ -n "$(find src pom.xml -newer "$JAR" \( -name '*.java' -o -name '*.json' -o -name '*.csv' -o -name '*.properties' -o -name 'pom.xml' \) 2>/dev/null | head -1)" ] && return 0
  return 1
}
if needs_build; then
  echo "[quest] building target/quest.jar (first run takes a minute)..."
  if [ -x ./mvnw ]; then ./mvnw -q -B -DskipTests package; else mvn -q -B -DskipTests package; fi
fi
exec java -jar "$JAR" "$@"
